MONGODB_URI="mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"
JWT_SECRET="clave-secreta-jwt-cambiar-en-produccion"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="IAM_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="IAM_SECRET_KEY"
AWS_S3_BUCKET="faceaccess-lab-uploads"
AWS_SNS_TOPIC_ARN="arn:aws:sns:us-east-1:<account>:faceaccess-lab-alerts"

# Rate limiting (opcional; valores por defecto si se omiten)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_COMPARE=10
RATE_LIMIT_STS=6
RATE_LIMIT_REGISTER=10
