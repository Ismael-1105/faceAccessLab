MONGODB_URI="mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"
JWT_SECRET="clave-secreta-jwt-cambiar-en-produccion"

# Duración del access token (corta por seguridad). Formato: 15m, 1h, 7d...
JWT_EXPIRES_IN="15m"
# Días de vida del refresh token (rotación automática al renovar).
REFRESH_TOKEN_DAYS=7

# Orígenes permitidos para CORS (separados por coma). Si se omite, solo se
# autoriza el propio dominio y localhost. Nunca se emite Access-Control-Allow-Origin: *.
# ALLOWED_ORIGINS="https://faceaccess.example.com,https://kiosco.example.com"

AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="IAM_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="IAM_SECRET_KEY"
AWS_S3_BUCKET="faceaccess-lab-uploads"
# Clave KMS para cifrar objetos S3 (aws:kms). Si se omite, se usa la clave
# gestionada por AWS del bucket.
AWS_KMS_KEY_ID="arn:aws:kms:us-east-1:<account>:key/<key-id>"
AWS_SNS_TOPIC_ARN="arn:aws:sns:us-east-1:<account>:faceaccess-lab-alerts"

# Consentimiento biométrico (días de vigencia; por defecto 365).
CONSENT_DAYS=365

# Rate limiting (opcional; valores por defecto si se omiten)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_COMPARE=10
RATE_LIMIT_STS=6
RATE_LIMIT_REGISTER=10

# Identidad y ubicación server-side del terminal. No usar variables NEXT_PUBLIC
# para secretos: el navegador recibe solo un attemptId efímero.
KIOSK_ID="Kiosk-042"
KIOSK_LAB="LAB-02"

# Incidentes de seguridad (accesos denegados repetidos)
INCIDENT_WINDOW_MIN=15
INCIDENT_THRESHOLD=5

# Observabilidad: umbrales de alertas operativas
ALERT_5XX_THRESHOLD=20          # errores 5xx en una ventana de 60 s
ALERT_LATENCY_MS=2000           # latencia por endpoint que dispara alerta
ALERT_KIOSK_IDLE_MIN=15         # minutos sin actividad para alertar kiosco inactivo

# Resolución DNS (ISS-10). Por defecto se usa el resolvedor del sistema.
# Solo hay que definirla si la red exige unos servidores concretos. Muchas redes
# institucionales bloquean el DNS saliente hacia resolvedores externos, y
# mongodb+srv:// necesita resolver registros SRV y TXT: forzar 8.8.8.8 ahí deja
# la aplicación sin base de datos.
# DNS_SERVERS=8.8.8.8,8.8.4.4
#
# Plan de contingencia si la resolución SRV falla en la red de la demostración:
# usar la cadena de conexión sin SRV, que no depende de esos registros.
# MONGODB_URI="mongodb://host1:27017,host2:27017,host3:27017/<db>?replicaSet=<rs>&ssl=true&authSource=admin"
